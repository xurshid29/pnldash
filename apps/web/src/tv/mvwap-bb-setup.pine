//@version=6
// mVWAP × BB basis setup — the operator's VWAP edge. Script version: v11 (2026-10-05).
// Docs: docs/vwap-setup.md — the walkthrough, tuning table, changelog, and the
// steps for shipping a new version (bump the version above, recreate the alert).
// Two setups in one script, so the same two watchlist alerts carry both.
// 1) RECLAIM: a top gainer pulls back under its month-anchored VWAP while the
// Bollinger basis (SMA 20) curls up beneath it; the trade is the reclaim. Since
// v11 the same rules also run on the year-anchored VWAP, each line with its own
// stages (the operator's SAIQ 2026-10-05: the spike stopped at the year VWAP,
// based under it, reclaimed it and ran). Messages say which line.
//   FORMING  basis 6–10% under mVWAP, rising, gap closing — or, on a fast approach,
//            price ≤10% under mVWAP and ≥3% above a rising basis → open the chart
//   READY    basis ≤6% under mVWAP — or, on a fast approach, price ≤5% under → entry zone
//   GO       price reclaims mVWAP decisively (close ≥2% above it, under it within 5 bars)
//            or the basis crosses above it (rising) — whichever first, within 60 bars of a
//            FORMING/READY, and never on a bar that closes lower than the bar before
// Price must close at or above the BB basis: a setup under the basis is no
// setup, and a close 2% under it ends the setup — the next reclaim is a fresh READY.
// 2) PULLBACK (v10): a fast run stretches price well above a VWAP line — the
// session VWAP or the month VWAP — and it comes back down to it.
//   PULLBACK  a close back within 5% above the line after a bar high ≥15% above it → be ready
//   BROKEN    a close under the line → the setup is over (the operator's exit)
//   HELD      price runs +10% from the PULLBACK close first
// Each line runs its own setup, and every message carries its touch number (the
// operator rates the first pullback after the first big move highest; our own
// data found the second as good — docs/vwap-setup.md §13.5).
// Run it as TradingView watchlist alerts — one on 1m and one on 2m (Premium allows 2):
// Symbols = the runners list (dashboard → 📐 tab → Copy list), session Extended,
// condition = this script → "Any alert() function call", once per bar close,
// webhook = https://pnldash.uz/api/tv/webhook?key=<TV_WEBHOOK_SECRET>.
// The alert message format below is parsed by apps/api/src/services/tv-setups.ts —
// keep the two in step. The offline replica (apps/api/scripts/research/vwap-setup/)
// mirrors this logic; update it with the script.
indicator("mVWAP x BB basis setup", shorttitle = "mVWAP-BB", overlay = true)

// Gainer filter: computed per ticker from its own bars — no screener, no ranking.
// A ticker that doesn't pass stays silent; -100 switches the filter off.
minDayGain = input.float(20.0, "Up at least % (day high vs prior close; -100 = filter off)", group = "Gainer filter (this ticker's own move)")
runnerDays = input.int(3,      "…today, or on any of the last N sessions (0 = today only)", minval = 0, maxval = 5, group = "Gainer filter (this ticker's own move)")
useAhGain  = input.bool(true,  "After hours, also count the move since today's close", group = "Gainer filter (this ticker's own move)")
rcLines    = input.string("Month + Year", "Lines: month VWAP, year VWAP or both (v11)", options = ["Month + Year", "Month", "Year"], group = "Setup")
maxPxBelow = input.float(15.0, "Price at most % under mVWAP", group = "Setup")
formBasis  = input.float(10.0, "FORMING: basis at most % under mVWAP", group = "Setup")
readyBasis = input.float(6.0,  "READY: basis at most % under mVWAP", group = "Setup")
holdTol    = input.float(0.0,  "Price may sit up to % under the basis (0 = must close above it)", group = "Setup")
failPct    = input.float(2.0,  "Setup breaks: close % under the basis", group = "Setup")
slopeBars  = input.int(3,      "Basis rising over N bars", minval = 1, group = "Setup")
useFast    = input.bool(true,  "Fast approach: price leads, the basis lags", group = "Fast approach")
fastAbove  = input.float(3.0,  "Price at least % above the basis", group = "Fast approach")
formPx     = input.float(10.0, "FORMING: price at most % under mVWAP", group = "Fast approach")
readyPx    = input.float(5.0,  "READY: price at most % under mVWAP", group = "Fast approach")
maxBasis   = input.float(15.0, "Basis at most % under mVWAP", group = "Fast approach")
fromBelow  = input.int(10,     "Price under mVWAP for the previous N bars (0 = off)", minval = 0, group = "Fast approach")
maxCycles  = input.int(6,      "Max setups per ticker per day", minval = 1, group = "Alerts")
goMemory   = input.int(60,     "GO up to N bars after the last FORMING/READY (0 = only while armed)", minval = 0, group = "Alerts")
goOn       = input.string("Either", "GO when", options = ["Either", "Price reclaim", "Basis cross"], group = "GO")
goAbovePct = input.float(2.0,  "Price reclaim: close at least % above mVWAP", group = "GO")
goWithin   = input.int(5,      "…having been at/under it within the previous N bars", minval = 1, group = "GO")
alertWin   = input.session("0400-2000", "Alert window (New York time)", group = "Alerts")
pbOn       = input.bool(true,   "Pullback setup on", group = "Pullback to VWAP (v10)")
pbLines    = input.string("Both", "Lines", options = ["Both", "Session", "Month"], group = "Pullback to VWAP (v10)")
pbArm      = input.float(15.0,  "Armed: a bar high at least % above the line (the big move)", group = "Pullback to VWAP (v10)")
pbNear     = input.float(5.0,   "PULLBACK: a close back within % above the line", group = "Pullback to VWAP (v10)")
pbBreak    = input.float(0.0,   "BROKEN: a close at least % under the line (0 = any close under it)", group = "Pullback to VWAP (v10)")
pbWin      = input.float(10.0,  "HELD: price runs % above the PULLBACK close", group = "Pullback to VWAP (v10)")
pbMax      = input.int(2,       "Pullbacks per line per day (touches; a close straight through counts)", minval = 1, group = "Pullback to VWAP (v10)")
pbTimeout  = input.int(60,      "Stop watching a pullback after N bars", minval = 1, group = "Pullback to VWAP (v10)")

// Same lines as the chart: VWAP anchor Month on hlc3, BB basis = SMA 20 of close,
// (v11) VWAP anchor Year — TradingView's own VWAP uses timeframe.change("12M") —
// and (v10, PULLBACK only) VWAP anchor Session, which resets at
// timeframe.change("D"), the 04:00 ET pre-market open on an Extended chart.
mvwap  = ta.vwap(hlc3, timeframe.change("M"))
yvwap  = ta.vwap(hlc3, timeframe.change("12M"))
svwap  = ta.vwap(hlc3, timeframe.change("D"))
basis  = ta.sma(close, 20)
// Strength inputs sent with every signal (v9): the signal bar's volume vs the
// average of the previous 20 bars, and the run-up over the previous 10 bars.
// The server scores GOs with them (services/tv-setups.ts goStrength).
volAvg20 = ta.sma(volume, 20)[1]
volX     = volAvg20 > 0 ? volume / volAvg20 : na
runUp10  = (close / close[10] - 1) * 100
plot(mvwap, "mVWAP", color.yellow)
plot(basis, "BB basis", color.green)
plot(svwap, "sVWAP", color.purple)
plot(yvwap, "yVWAP", color.blue)

// Top gainer: today's high vs the prior regular-session close (like Finviz
// Change), or the same in any of the last `runnerDays` sessions — a second- or
// third-day runner sets up BEFORE it is up on the day (MEDS 2026-09-18) — or,
// after hours, the high since today's close (Finviz's AH change: AMOD fell 24%
// on 2026-10-01, then ran +70% after hours from a +19.8% day high).
newDay = timeframe.change("D")
var float lastRegClose = na
var float prevDayClose = na
var float dayHigh      = na
var dayGains = array.new<float>()   // day-high gains of finished sessions, newest first (max 5)
var float ahHigh       = na   // high since today's close (post-market bars)
if newDay
    array.unshift(dayGains, (dayHigh / prevDayClose - 1) * 100)
    if array.size(dayGains) > 5
        array.pop(dayGains)
    prevDayClose := lastRegClose
    dayHigh      := high
    ahHigh       := na
else
    dayHigh := na(dayHigh) ? high : math.max(dayHigh, high)
if session.ismarket
    lastRegClose := close
if session.ispostmarket
    ahHigh := na(ahHigh) ? high : math.max(ahHigh, high)
ahGain = session.ispostmarket and not na(ahHigh) ? (ahHigh / lastRegClose - 1) * 100 : na
dayHighGain = (dayHigh / prevDayClose - 1) * 100
float recentGain = -100.0
lookback = math.min(runnerDays, array.size(dayGains))
if lookback > 0
    for i = 0 to lookback - 1
        g = array.get(dayGains, i)
        if not na(g)
            recentGain := math.max(recentGain, g)
gainer = (not na(dayHighGain) and dayHighGain >= minDayGain) or recentGain >= minDayGain or
     (useAhGain and not na(ahGain) and ahGain >= minDayGain)

// Line-independent parts of the reclaim setup.
basisUp  = basis > basis[slopeBars]
holding  = close >= basis * (1 - holdTol / 100)
inWindow = not na(time(timeframe.period, alertWin, "America/New_York"))

// The reclaim conditions on one line. v11 runs the same rules on the month VWAP
// and the year VWAP. The function is called for each line on every bar, so the
// history inside it (gap closing, the recent-close counts, the cross) stays intact:
// v6 evaluates and/or lazily, and a skipped math.sum would corrupt its history.
// Distances are positive under the line.
// Two shapes. BASE: price consolidates under the line until the basis converges
// (AIXI, VEEA). FAST: price runs at the line while the 20-bar basis lags far
// behind (MEDS 09-18, NIVF 09-30), reached by price distance instead. FAST only
// counts when approaching from below: a spike that falls back to the line (AMOD
// 2026-09-01) is not an approach.
// GO: the basis cross alone fires late on fast moves, because the 20-bar basis
// lags; it crossed near the top on NIVF 2026-09-30 (+40% after the break). The
// decisive price reclaim marks the breakout itself. A cross only counts with the
// basis RISING, and no GO prints on a falling bar: early in a month the line is
// built on thin volume, and one heavy red bar can drag it under a flat basis — a
// "cross" with price below both (AIXI 2026-10-01 09:38).
reclaimConds(float ln) =>
    float pxB    = (ln - close) / ln * 100
    float bB     = (ln - basis) / ln * 100
    bool  gapC   = bB < bB[slopeBars]
    float aboveR = math.sum(close >= ln ? 1.0 : 0.0, math.max(fromBelow, 1))[1]   // closes at/above it, previous `fromBelow` bars
    float underR = math.sum(close <= ln ? 1.0 : 0.0, goWithin)[1]
    bool  crossUp = ta.crossover(basis, ln)
    bool  okLine = gainer and not na(ln) and not na(basis)
    bool  inZ    = okLine and pxB > 0 and pxB <= maxPxBelow and basisUp and holding
    bool  fromOk = fromBelow == 0 or aboveR == 0
    bool  fastA  = useFast and fromOk and close >= basis * (1 + fastAbove / 100) and bB <= maxBasis
    bool  bForm  = bB > readyBasis and bB <= formBasis
    bool  bReady = bB > 0 and bB <= readyBasis
    bool  frm    = inZ and gapC and (bForm or (fastA and pxB <= formPx))
    bool  rdy    = inZ and (bReady or (fastA and pxB <= readyPx))
    bool  recl   = basisUp and underR > 0 and close > ln * (1 + goAbovePct / 100)
    bool  crOk   = crossUp and basisUp
    bool  trig   = goOn == "Basis cross" ? crOk : goOn == "Price reclaim" ? recl : (crOk or recl)
    bool  g      = okLine and trig and close >= close[1]
    [frm, rdy, g, bForm, bReady, recl, bB]

[mForm, mReady, mGo, mBaseForm, mBaseReady, mRecl, mBasisBelow] = reclaimConds(mvwap)
[yForm, yReady, yGo, yBaseForm, yBaseReady, yRecl, yBasisBelow] = reclaimConds(yvwap)

// Stages, per line: 0 idle, 1 forming, 2 ready, 3 go; each fires once per setup.
// A setup that breaks (close under the line and failPct under the basis) re-arms.
// GO also fires within `goMemory` bars of the last FORMING/READY when a break
// came in between (AIXI 2026-10-02: READY, dip under the basis, then one bar
// back over both lines). Outside the alert window nothing fires and no stage advances.
type RcLine
    int stage        = 0
    int cycles       = 0
    int lastSetupBar = na

// One bar of one line's stage machine; returns the stage that fires (0 = none).
method advance(RcLine s, float ln, bool frm, bool rdy, bool g) =>
    if s.stage > 0 and close < ln and close < basis * (1 - failPct / 100)
        s.stage := 0
    bool recentSetup = goMemory > 0 and not na(s.lastSetupBar) and bar_index - s.lastSetupBar <= goMemory
    int target = 0
    if g and s.stage < 3 and (s.stage >= 1 or recentSetup)
        target := 3
    else if rdy
        target := 2
    else if frm
        target := 1
    bool fire = inWindow and target > s.stage and (s.stage > 0 or target == 3 or s.cycles < maxCycles)
    if fire
        if s.stage == 0 and target < 3
            s.cycles := s.cycles + 1
        if target < 3
            s.lastSetupBar := bar_index
        s.stage := target
    fire ? target : 0

var RcLine rcM = RcLine.new()
var RcLine rcY = RcLine.new()
if newDay
    rcM.stage        := 0
    rcM.cycles       := 0
    rcM.lastSetupBar := na
    rcY.stage        := 0
    rcY.cycles       := 0
    rcY.lastSetupBar := na
int fireM = 0
int fireY = 0
if rcLines != "Year"
    fireM := rcM.advance(mvwap, mForm, mReady, mGo)
if rcLines != "Month"
    fireY := rcY.advance(yvwap, yForm, yReady, yGo)

pctVs(float ln) => (close >= ln ? "+" : "") + str.tostring((close / ln - 1) * 100, "#.0")
// The message is a contract with services/tv-setups.ts parseTvMessage. `basis %`
// is measured against the setup's own line:
//   READY AIXI 1.48 | mVWAP 1.57 (-5.7%) | yVWAP 2.9 (-49.0%) | basis 1.49 (-5.1%) | line month | day high +41% | vol 1.2x | run +3.0% | tf 1 | path base
rcMsg(int target, string lineName, float bBelow, bool bForm, bool bReady, bool recl) =>
    string msg = (target == 3 ? "GO" : target == 2 ? "READY" : "FORMING") + " " + syminfo.ticker + " " + str.tostring(close, format.mintick)
    msg += " | mVWAP " + str.tostring(mvwap, format.mintick) + " (" + pctVs(mvwap) + "%)"
    if not na(yvwap)
        msg += " | yVWAP " + str.tostring(yvwap, format.mintick) + " (" + pctVs(yvwap) + "%)"
    msg += " | basis " + str.tostring(basis, format.mintick) + " (" + str.tostring(-bBelow, "#.0") + "%)"
    msg += " | line " + lineName
    msg += " | day high " + (dayHighGain >= 0 ? "+" : "") + str.tostring(dayHighGain, "#") + "%"
    if not na(ahGain)
        msg += " | ah " + (ahGain >= 0 ? "+" : "") + str.tostring(ahGain, "#") + "%"
    if not na(volX)
        msg += " | vol " + str.tostring(volX, "#.#") + "x"
    if not na(runUp10)
        msg += " | run " + (runUp10 >= 0 ? "+" : "") + str.tostring(runUp10, "#.#") + "%"
    msg += " | tf " + timeframe.period
    if target < 3
        msg += " | path " + ((target == 2 ? bReady : bForm) ? "base" : "fast")
    else
        msg += " | via " + (recl and goOn != "Basis cross" ? "reclaim" : "cross")
    msg

// Both lines firing the same stage on one bar (they can sit close together) is
// one "line both" message, with the month line's basis distance.
if fireM > 0 and fireM == fireY
    alert(rcMsg(fireM, "both", mBasisBelow, mBaseForm, mBaseReady, mRecl), alert.freq_once_per_bar_close)
else
    if fireM > 0
        alert(rcMsg(fireM, "month", mBasisBelow, mBaseForm, mBaseReady, mRecl), alert.freq_once_per_bar_close)
    if fireY > 0
        alert(rcMsg(fireY, "year", yBasisBelow, yBaseForm, yBaseReady, yRecl), alert.freq_once_per_bar_close)

// ── 2) PULLBACK (v10) ─────────────────────────────────────────────────────────
// A fast run stretches price well above a VWAP line and it comes back down to it
// (operator, 2026-10-05: SAIQ and SDEV on the session line, VEEA 2026-09-15 on
// the month line). Each line keeps its own state, reset every day:
//   armed     by a bar high ≥ pbArm% above the line (gainers only)
//   PULLBACK  on a LATER close within pbNear% above the line ("be ready")
//   BROKEN    then a close pbBreak% under the line — the operator's exit — or
//   HELD      a high +pbWin% above the PULLBACK close, whichever comes first;
//             after pbTimeout bars the pullback is dropped silently.
// A close straight through the line while armed uses up a touch with no
// PULLBACK. Re-arming needs a new bar high ≥ pbArm% above the line.
type PbLine
    bool  armed    = false
    int   armBar   = na
    float peakPct  = na
    int   touches  = 0
    bool  open     = false
    float entry    = na
    int   alertBar = na

// One bar of one line's setup: 0 nothing, 1 PULLBACK, 2 BROKEN, 3 HELD.
method step(PbLine s, float ln, bool canArm) =>
    int ev = 0
    if not na(ln) and ln > 0
        if s.open
            if close < ln * (1 - pbBreak / 100)
                s.open := false
                ev := 2
            else if high >= s.entry * (1 + pbWin / 100)
                s.open := false
                ev := 3
            else if bar_index - s.alertBar >= pbTimeout
                s.open := false
        if not s.open
            float stretch = (high / ln - 1) * 100
            if not s.armed
                if canArm and stretch >= pbArm
                    s.armed   := true
                    s.armBar  := bar_index
                    s.peakPct := stretch
            else
                s.peakPct := math.max(s.peakPct, stretch)
                if bar_index > s.armBar and close <= ln * (1 + pbNear / 100)
                    s.armed   := false
                    s.touches := s.touches + 1
                    if ev == 0 and s.touches <= pbMax and close >= ln * (1 - pbBreak / 100)
                        s.open     := true
                        s.entry    := close
                        s.alertBar := bar_index
                        ev := 1
    ev

var PbLine pbS = PbLine.new()
var PbLine pbM = PbLine.new()
if newDay
    pbS.armed   := false
    pbS.open    := false
    pbS.touches := 0
    pbM.armed   := false
    pbM.open    := false
    pbM.touches := 0
int evS = 0
int evM = 0
if pbOn and inWindow
    if pbLines != "Month"
        evS := pbS.step(svwap, gainer)
    if pbLines != "Session"
        evM := pbM.step(mvwap, gainer)

// The message — a contract with services/tv-setups.ts parseTvMessage, like the RECLAIM one:
//   PULLBACK SAIQ 6.2 | sVWAP 6.16 (+0.7%) | mVWAP 4.1 (+51.2%) | line session | touch 2 | peak +17% | day high +336% | vol 0.6x | run -9.6% | tf 1
pbMsg(int ev, string lineName, int touch, float peak) =>
    string msg = (ev == 1 ? "PULLBACK" : ev == 2 ? "BROKEN" : "HELD") + " " + syminfo.ticker + " " + str.tostring(close, format.mintick)
    msg += " | sVWAP " + str.tostring(svwap, format.mintick) + " (" + pctVs(svwap) + "%)"
    msg += " | mVWAP " + str.tostring(mvwap, format.mintick) + " (" + pctVs(mvwap) + "%)"
    msg += " | line " + lineName + " | touch " + str.tostring(touch)
    if ev == 1 and not na(peak)
        msg += " | peak +" + str.tostring(peak, "#") + "%"
    msg += " | day high " + (dayHighGain >= 0 ? "+" : "") + str.tostring(dayHighGain, "#") + "%"
    if not na(ahGain)
        msg += " | ah " + (ahGain >= 0 ? "+" : "") + str.tostring(ahGain, "#") + "%"
    if not na(volX)
        msg += " | vol " + str.tostring(volX, "#.#") + "x"
    if not na(runUp10)
        msg += " | run " + (runUp10 >= 0 ? "+" : "") + str.tostring(runUp10, "#.#") + "%"
    msg + " | tf " + timeframe.period

// Both lines firing the same event on one bar (they sit close together early in
// a month) is one "line both" message.
if evS > 0 and evS == evM
    alert(pbMsg(evS, "both", math.min(pbS.touches, pbM.touches), math.max(pbS.peakPct, pbM.peakPct)), alert.freq_once_per_bar_close)
else
    if evS > 0
        alert(pbMsg(evS, "session", pbS.touches, pbS.peakPct), alert.freq_once_per_bar_close)
    if evM > 0
        alert(pbMsg(evM, "month", pbM.touches, pbM.peakPct), alert.freq_once_per_bar_close)

plotshape(evS == 1 or evM == 1, "Pullback", shape.diamond, location.belowbar, color.aqua, size = size.tiny)
plotshape(evS == 2 or evM == 2, "Broken", shape.xcross, location.abovebar, color.red, size = size.tiny)
plotshape(evS == 3 or evM == 3, "Held", shape.flag, location.abovebar, color.lime, size = size.tiny)
plotshape(fireM == 1 or fireY == 1, "Forming", shape.circle, location.belowbar, color.orange, size = size.tiny)
plotshape(fireM == 2 or fireY == 2, "Ready", shape.triangleup, location.belowbar, color.yellow, size = size.small)
plotshape(fireM == 3 or fireY == 3, "Go", shape.labelup, location.belowbar, color.lime, text = "GO", textcolor = color.black, size = size.small)
alertcondition(fireM == 2 or fireY == 2, "READY", "READY {{ticker}} {{close}} | tf {{interval}}")
alertcondition(fireM == 3 or fireY == 3, "GO", "GO {{ticker}} {{close}} | tf {{interval}}")
